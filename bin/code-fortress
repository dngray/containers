#!/bin/bash
# ~/.local/bin/code-fortress

# 0. Repository Self-Location
# code-fortress is deployed as a single symlink (~/.local/bin/code-fortress -> .../bin/code-fortress).
# Resolve it, then walk up looking for the justfile marker to find the repo root.
SELF=$(command -v code-fortress 2>/dev/null) || SELF=$0
SELF=$(realpath "$SELF" 2>/dev/null) || true
d=$(dirname "$SELF")
REPO_ROOT=
while [ "$d" != "/" ]; do
  if [ -f "$d/justfile" ]; then
    REPO_ROOT=$d
    break
  fi
  d=$(dirname "$d")
done

if [ -n "$REPO_ROOT" ]; then
  # Make repo tools (e.g. ai-secure) resolvable inside the fortress panes
  export PATH="$REPO_ROOT/bin:$PATH"
else
  echo "error: cannot locate the containers repo from '$SELF'." >&2
  echo "install bin/code-fortress as a symlink into the repo (e.g. ~/.local/bin/code-fortress -> ~/containers/bin/code-fortress)." >&2
  exit 1
fi

# 1. Identity & Context Resolution
RAW_PATH=${1:-"$HOME/src"}
FORTRESS_PATH=$(realpath "$RAW_PATH") || exit 1
export FORTRESS_PATH
PROJECT_ID=$(basename "$FORTRESS_PATH")
export POD_NAME="ai-fortress-pod-$PROJECT_ID"
MODE=${2:-"opencode"}
# OpenCode-only image variant (tag suffix): latest | full-binary | basic-binary
VARIANT=${3:-"latest"}

# Validate operation mode immediately to fail fast
case "$MODE" in
"aider" | "opencode" | "goose") ;;
*)
  echo "❌ Usage: code-fortress <path> [aider|opencode|goose] [latest|full-binary|basic-binary]"
  exit 1
  ;;
esac

# Validate the image variant tag; only opencode honours it today
case "$VARIANT" in
"latest" | "full-binary" | "basic-binary") ;;
*)
  echo "❌ Usage: code-fortress <path> [aider|opencode|goose] [latest|full-binary|basic-binary]"
  exit 1
  ;;
esac

if [ "$MODE" != "opencode" ] && [ "$VARIANT" != "latest" ]; then
  echo "⚠️  Image variant '$VARIANT' only applies to opencode mode; ignoring."
  VARIANT="latest"
fi

# 2. Strict Context-Aware Cleanup
cleanup_fortress() {
  echo -e "\n🛡️  Dismantling Fortress components for $PROJECT_ID..."
  # Terminate the core pod container structure
  podman pod rm -f -t 0 "$POD_NAME" 2>/dev/null

  # Clean up orphaned containers explicitly belonging ONLY to this project context
  podman ps -a --filter "name=ai-fortress-.*-$PROJECT_ID" --format "{{.ID}}" | xargs -r podman rm -f -t 0 >/dev/null 2>&1
  echo "🏰 Gates closed."
}

# Bind trap to multiple termination signals to guarantee cleanup if Zellij dies abruptly
trap cleanup_fortress EXIT INT TERM

# 3. Infrastructure Prep
echo "🏗️  Purging old instances for $POD_NAME..."
podman pod rm -f -t 0 "$POD_NAME" 2>/dev/null

echo "🏗️  Initializing Fortress Pod (Shared Mode): $POD_NAME"
podman pod create \
  --name "$POD_NAME" \
  --share net \
  --userns keep-id \
  --network bridge

# 4. Secrets Fetching
echo "🔑 Unlocking fortress credentials..."
export OPENCODE_SERVER_USERNAME="opencode"
OPENCODE_SERVER_PASSWORD=$(gopass show ai/opencode-server-pass) || exit 1
OPENROUTER_API_KEY=$(gopass show ai/openrouter-api-key) || exit 1
OPENAI_API_KEY=$(gopass show ai/openai-api-key) || exit 1
ANTHROPIC_API_KEY=$(gopass show ai/anthropic-api-key) || exit 1
export OPENCODE_SERVER_PASSWORD OPENROUTER_API_KEY OPENAI_API_KEY ANTHROPIC_API_KEY
export OPENCODE_VARIANT="$VARIANT"

export GOGOOSE_MODE="${GOOSE_MODE:-nanogpt}"

# 5. Execution Environment Launch
echo "🏰 Fortifying workspace in $MODE mode at: $FORTRESS_PATH"
zellij --layout "$REPO_ROOT/layouts/${MODE}-fortress.kdl"
