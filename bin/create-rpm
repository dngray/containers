#!/bin/sh
set -e

# shellcheck source=lib/cli.sh
REPO_ROOT=$(CDPATH= cd "$(dirname "$0")/.." && pwd)
. "${REPO_ROOT}/lib/cli.sh"

if [ "$#" -lt 2 ]; then
  error "Usage: $0 <spec-path> <build-dir> [source-paths...]"
  exit 1
fi

SPEC_PATH="$1"
BUILD_DIR="$2"
shift 2

if ! command -v rpmbuild >/dev/null 2>&1; then
  error "rpmbuild not found. Install rpm-build: sudo dnf install rpm-build"
  exit 1
fi

if ! rpm -q selinux-policy-devel >/dev/null 2>&1; then
  error "selinux-policy-devel not found. Install: sudo dnf install selinux-policy-devel"
  exit 1
fi

mkdir -p "${BUILD_DIR}/BUILD" "${BUILD_DIR}/RPMS" "${BUILD_DIR}/SPECS" "${BUILD_DIR}/SOURCES"

cp "${SPEC_PATH}" "${BUILD_DIR}/SPECS/"
for src in "$@"; do
  cp "${src}" "${BUILD_DIR}/SOURCES/"
done

# rpmbuild %prep cds into %{_builddir} before running. A relative _topdir would
# make %{_sourcedir} relative too, and the spec's "cp %{_sourcedir}/x.cil ."
# would then resolve against the build dir instead of the topdir. Resolve
# everything against the invocation cwd while we still know it.
BUILD_DIR=$(CDPATH= cd "${BUILD_DIR}" && pwd)

# Fail here with a clear message rather than letting %prep fail on a missing
# source: rpmbuild's "cp: cannot stat" gives no hint that create-rpm staged it.
staged=0
for src in "$@"; do
  base=$(basename "${src}")
  if [ ! -f "${BUILD_DIR}/SOURCES/${base}" ]; then
    error "create-rpm: '${src}' was not staged into SOURCES."
    exit 1
  fi
  staged=$((staged + 1))
done

info "==> Building RPM (${staged} source file(s) staged)..."
rpmbuild -ba "${BUILD_DIR}/SPECS/$(basename "${SPEC_PATH}")" \
  --define "_topdir ${BUILD_DIR}"
