policy_module(selinux-snapclient, 1.0.0)

gen_require(`
    type container_runtime_t;
    type container_file_t;
    type tmpfs_t;
    type unconfined_t;
    type sound_device_t;
    type urandom_device_t;
    type user_tmp_t;
    role system_r;

    # Dynamic container sandboxing (same fix as aerc/fortress): crun hands the
    # process a context carrying changing MCS category tags (s0:cXXX,cYYY), and
    # the kernel drops the domain transition unless the target domain is
    # registered as a container/MCS-constrained domain and holds
    # dyntransition+setcurrent on the runtime transition check.
    # NOTE: keep this block free of apostrophes -- m4 quotes gen_require with
    # backtick/apostrophe pairs, so a lone one would terminate the body early
    # and leave a stray quote for checkmodule to reject.
    attribute container_domain;
    attribute container_net_domain;
    attribute mcs_constrained_type;

    class key { create };
    class process { transition dyntransition noatsecure rlimitinh siginh fork signal signull sigkill getattr setcurrent };
    class fd use;
    class fifo_file { write ioctl };
    class file { read open getattr map write lock execute entrypoint execute_no_trans };
    class dir { search read open getattr };
    class lnk_file read;
    class unix_stream_socket connectto;
    class chr_file { read write open ioctl };
    class sock_file { write read open getattr };
')

# ========================================================
# Type Declarations & Domain Setup
# ========================================================

# The running container process domain
type snapclient_t;
role system_r types snapclient_t;
virt_sandbox_domain(snapclient_t)

# Register as a standard container domain so the runtime can pass dynamic MCS
# tags into the sandbox, and so the transition is not rejected as unconfined.
typeattribute snapclient_t container_domain;
typeattribute snapclient_t container_net_domain;
typeattribute snapclient_t mcs_constrained_type;

# The entrypoint executable file type (Best Practice)
type snapclient_exec_t;
files_type(snapclient_exec_t)

# ========================================================
# Domain Transition Rules
# ========================================================

# Allow the container runtime to transition to snapclient_t when executing snapclient_exec_t
type_transition container_runtime_t snapclient_exec_t:process snapclient_t;

# Keep the role valid across the transition (crun acts as system_r)
role_transition system_r snapclient_t:process system_r;

# Make snapclient_exec_t a valid entry point for the snapclient_t domain
allow snapclient_t snapclient_exec_t:file entrypoint;

# Allow container runtime to see and run the entrypoint script
allow container_runtime_t snapclient_exec_t:file { read open getattr execute };

# ========================================================
# Internal & Self Process Rules
# ========================================================
allow snapclient_t self:process { fork signal dyntransition transition };
allow snapclient_t self:tcp_socket { create connect shutdown read ioctl write };
allow snapclient_t self:udp_socket { create bind write read setopt };
allow snapclient_t self:dir { search read open };
allow snapclient_t self:lnk_file read;

# ========================================================
# Container Runtime & Image File Access
# ========================================================
allow container_runtime_t snapclient_t:key create;
allow container_runtime_t snapclient_t:process { transition dyntransition setcurrent noatsecure rlimitinh siginh signal signull sigkill getattr };
allow container_runtime_t snapclient_t:dir search;
allow container_runtime_t snapclient_t:file { read open getattr };

allow snapclient_t container_runtime_t:fd use;
allow snapclient_t container_runtime_t:fifo_file { write ioctl };
allow snapclient_t container_file_t:dir search;
allow snapclient_t container_file_t:file { execute read open getattr execute_no_trans };
allow snapclient_t container_file_t:lnk_file read;
allow snapclient_t tmpfs_t:file map;
allow snapclient_t unconfined_t:unix_stream_socket connectto;

# ========================================================
# Kernel & Hardware Layer
# ========================================================
kernel_read_proc_symlinks(snapclient_t)
allow snapclient_t sound_device_t:chr_file { read write open ioctl };
dev_rw_null(snapclient_t)
dev_read_rand(snapclient_t)

# ========================================================
# Network Layer
# ========================================================
corenet_udp_bind_all_nodes(snapclient_t)
corenet_tcp_connect_all_unreserved_ports(snapclient_t)

# ========================================================
# Audio Interop (PulseAudio / PipeWire / Sound)
# ========================================================
pulseaudio_rw_home_files(snapclient_t)

# Random seeding needs /dev/urandom access
allow snapclient_t urandom_device_t:chr_file { read open };

# PulseAudio/PipeWire UNIX socket streaming over /run/user paths
allow snapclient_t user_tmp_t:dir { search read open getattr };
allow snapclient_t user_tmp_t:sock_file { write read open getattr };
